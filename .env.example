# ==============================================================================
# DRISHTI ENVIRONMENT CONFIGURATION (SIH26002)
# Copy to .env or set environment variables before launching server.py
#
# NOTE ON SAFETY & DEMO DEGRADATION:
# All variables below are OPTIONAL. If SMTP credentials are not configured,
# DRISHTI automatically falls back safely to SIMULATED DISPATCH (DEMO MODE).
# It will never throw, hang, or send unauthorized emails to real authorities.
# ==============================================================================

# --- Optional SMTP Live Dispatch Credentials ---
# Required ONLY if you wish to enable live email delivery during evaluation:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.demo.account@gmail.com
SMTP_PASS=your-16-character-app-password
SOS_FROM="DRISHTI Emergency Dispatch <your.demo.account@gmail.com>"

# --- Safety Recipient Override (Recommended for Testing) ---
# When set, all SOS distress transmissions are safely redirected ONLY to this email:
SOS_TEST_RECIPIENT=your-team-eval-inbox@example.com

# --- Optional AI Drafting Key ---
# When set, Google Gemini 2.0 Flash is used to draft formal rescue alerts:
GEMINI_API_KEY=your-gemini-api-key-here

# --- Server Port ---
PORT=8080

# --- Google Maps browser API key ---
# Copy the key into js/config.js for local browser use.
# Restrict the key by HTTP referrer and API before deployment.
